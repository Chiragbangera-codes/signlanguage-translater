frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Next.js build cache and telemetry
frontend/.next/
frontend/.vercel/

# Python dependencies and environments
backend/venv/
env-*/
.env-*/
