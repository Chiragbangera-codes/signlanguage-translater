# ML training models and datasets (large files)
ml/model/
dataset/*.csv

# NOTE: frontend/public/model/ is deliberately NOT ignored. Vercel builds from
# git, so the exported TF.js model must be committed or the deployed app finds
# no model and silently falls back to the slow API path.

# Dataset archives produced by scripts/import_dataset.py
dataset/*.zip
scripts/*.zip

# Local AI-assistant tooling and notes
.claude/
CLAUDE.md
AGENTS.md
**/CLAUDE.md
**/AGENTS.md

# Preprocessed training splits — regenerate with `python ml/preprocess.py`.
# These grow past GitHub's 100 MB hard limit as the vocabulary scales.
dataset/preprocessed_data*.npz

# Imported classes held back from training — re-import with
# scripts/import_dataset.py rather than versioning unused data.
dataset/words_unused/
